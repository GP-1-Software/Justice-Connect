messages and conversations in one sql sql_query:
-- Create messages table
CREATE TABLE messages (
    message_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    conversation_id UUID NOT NULL,
    sender_id INTEGER NOT NULL,
    sender_type VARCHAR(20) NOT NULL CHECK (sender_type IN ('client', 'lawyer')),
    receiver_id INTEGER NOT NULL,
    receiver_type VARCHAR(20) NOT NULL CHECK (receiver_type IN ('client', 'lawyer')),
    content TEXT NOT NULL,
    is_read BOOLEAN DEFAULT FALSE,
    read_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    has_attachments boolean null default false,
    deleted_for jsonb null default '[]'::jsonb
);

-- Create conversations table
CREATE TABLE conversations (
    conversation_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    participant1_id INTEGER NOT NULL,
    participant1_type VARCHAR(20) NOT NULL CHECK (participant1_type IN ('client', 'lawyer')),
    participant2_id INTEGER NOT NULL,
    participant2_type VARCHAR(20) NOT NULL CHECK (participant2_type IN ('client', 'lawyer')),
    last_message_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    UNIQUE(participant1_id, participant1_type, participant2_id, participant2_type)
);

-- Create indexes
CREATE INDEX idx_messages_conversation_id ON messages(conversation_id);
CREATE INDEX idx_messages_sender ON messages(sender_id, sender_type);
CREATE INDEX idx_messages_receiver ON messages(receiver_id, receiver_type);
CREATE INDEX idx_messages_created_at ON messages(created_at DESC);
CREATE INDEX idx_conversations_participants ON conversations(participant1_id, participant1_type, participant2_id, participant2_type);

-- Enable Realtime
ALTER PUBLICATION supabase_realtime ADD TABLE messages;
ALTER PUBLICATION supabase_realtime ADD TABLE conversations;
______________________________________


-- Deleted conversations 
CREATE TABLE deleted_conversations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    conversation_id UUID NOT NULL REFERENCES conversations(conversation_id) ON DELETE CASCADE,
    deleted_by_user_id INTEGER NOT NULL,
    deleted_by_user_type VARCHAR(20) NOT NULL CHECK (deleted_by_user_type IN ('client', 'lawyer')),
    deleted_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    UNIQUE(conversation_id, deleted_by_user_id, deleted_by_user_type)
);

-- Blocked users  
CREATE TABLE blocked_users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    blocker_id INTEGER NOT NULL,
    blocker_type VARCHAR(20) NOT NULL CHECK (blocker_type IN ('client', 'lawyer')),
    blocked_id INTEGER NOT NULL,
    blocked_type VARCHAR(20) NOT NULL CHECK (blocked_type IN ('client', 'lawyer')),
    blocked_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    reason TEXT,
    UNIQUE(blocker_id, blocker_type, blocked_id, blocked_type)
);

-- Message attachments  
CREATE TABLE message_attachments (
    attachment_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    message_id UUID NOT NULL REFERENCES messages(message_id) ON DELETE CASCADE,
    file_name VARCHAR(255) NOT NULL,
    file_url TEXT NOT NULL,
    file_type VARCHAR(50) NOT NULL,
    file_size BIGINT NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

ALTER TABLE messages ADD COLUMN has_attachments BOOLEAN DEFAULT FALSE;

-- Indexes للأداء
CREATE INDEX idx_deleted_conversations_user ON deleted_conversations(deleted_by_user_id, deleted_by_user_type);
CREATE INDEX idx_blocked_users_blocker ON blocked_users(blocker_id, blocker_type);
CREATE INDEX idx_blocked_users_blocked ON blocked_users(blocked_id, blocked_type);
CREATE INDEX idx_message_attachments_message ON message_attachments(message_id);
