# Server Configuration

PORT=5000

# Supabase Configuration

# Get these from: https://app.supabase.com → Your Project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# Google Gemini API Key  ( https://aistudio.google.com/app/apikey )
