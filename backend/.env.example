# Server Configuration

PORT=5000

# Supabase Configuration

# Get these from: https://app.supabase.com → Your Project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# OpenAI API Key (https://platform.openai.com/api-keys)
# Used for JusticeAI (legal chatbot) & SystemAI (SQL generation and analysis)

OPENAI_API_KEY=

SERP_API_KEY=

# Email Configuration , https://myaccount.google.com/security
EMAIL_ENABLED=0    # Set to 1 to enable email notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=Yor-Email
EMAIL_PASS=Yor-Password




# ================================================
# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. Never commit .env to git

